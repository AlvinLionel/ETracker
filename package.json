{
  "name": "etracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run prepare:ocr-assets",
    "build": "tsc && vite build",
    "prebuild": "npm run prepare:ocr-assets",
    "prepare:ocr-assets": "node scripts/prepare-ocr-assets.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:e2e": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "build:e2e:frontend": "npm run prepare:ocr-assets && tsc && vite build --mode e2e",
    "test:e2e": "npm run build:e2e && node --test e2e/desktop.e2e.mjs",
    "setup:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-e2e.ps1",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^1.71.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "selenium-webdriver": "^4.51.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
